---
import { site } from '../data/lenses';
import { url } from '../lib/url';

// The contact links live in the header now (there is no footer).
const nav = [{ label: 'Email', href: `mailto:${site.email}` }, ...site.links];
---

<header class="site-header">
  <a class="site-name" href={url('/')}>{site.name}</a>
  <nav class="site-nav mono" aria-label="Contact">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</header>
